# Copy to .env.development.local for local development.

# Postgres — local Docker database from `pnpm db:start`.
GABAR_DATABASE_URL=postgres://postgres:postgres@localhost:55432/gabar

# Supabase Storage — extracted document texts. Only the publishable key: the
# site can read texts of published exams and nothing else. Leave empty locally
# (local seeds keep the text in Postgres).
GABAR_SUPABASE_URL=
GABAR_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (anti-bot on public forms). Leave empty locally: the
# widget is skipped. Test site key that always passes (E2E only):
# 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
