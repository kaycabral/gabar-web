# Copy to apps/web/.env.development.local for local development.

# Postgres — local Docker database from `pnpm --filter @gabar/web db:start`.
GABAR_DATABASE_URL=postgres://postgres:postgres@localhost:55432/gabar

# Cloudflare Turnstile (anti-bot on public forms). Leave empty locally: the
# widget is skipped. Test site key that always passes (E2E only):
# 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
