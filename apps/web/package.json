{
  "name": "@gabar/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start",
    "db:start": "POSTGRES_DB=gabar POSTGRES_PORT=55432 docker compose -p gabar-pg -f ../../docker/postgres.compose.yaml up -d --wait",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:seed": "pnpm --filter @gabar/db run db:seed:dev"
  },
  "dependencies": {
    "@cbrl/br": "^0.1.0",
    "@cbrl/design": "^0.3.0",
    "@cbrl/log": "^0.1.0",
    "@cbrl/next": "^0.1.1",
    "@gabar/db": "workspace:*",
    "@gabar/shared": "workspace:*",
    "@tailwindcss/typography": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "next": "16.4.6",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "catalog:",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cbrl/eslint-config": "^0.2.1",
    "@cbrl/testing": "^0.3.0",
    "@cbrl/tsconfig": "^0.1.1",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serve": "^14.2.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
