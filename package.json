{
  "name": "gabar-web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "node .husky/install.mjs",
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration:pg": "vitest run --config vitest.pg.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "db:start": "POSTGRES_DB=gabar POSTGRES_PORT=55432 docker compose -p gabar-pg -f docker/postgres.compose.yaml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-dev.ts"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "pnpm": {
    "overrides": {
      "vite": "^8.0.13"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@cbrl/br": "^0.1.0",
    "@cbrl/design": "^0.2.0",
    "@cbrl/env": "^0.1.1",
    "@cbrl/log": "^0.1.0",
    "@cbrl/next": "^0.1.0",
    "@cbrl/pg": "^0.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "drizzle-orm": "~0.45.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cbrl/commitlint-config": "^0.1.0",
    "@cbrl/eslint-config": "^0.2.0",
    "@cbrl/prettier-config": "^0.1.0",
    "@cbrl/testing": "^0.2.0",
    "@cbrl/tsconfig": "^0.1.0",
    "@commitlint/cli": "^19.8.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
